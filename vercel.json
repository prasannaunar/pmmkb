{
  "installCommand": "npm install --prefix web",
  "buildCommand": "npm run --prefix web build",
  "outputDirectory": "web/out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pmmkb.vercel.app"
        }
      ],
      "destination": "https://www.pmmkb.com/$1",
      "permanent": true
    }
  ]
}
